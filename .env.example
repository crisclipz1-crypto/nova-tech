# ---------------------------------------------------------------------------
# Base de datos — el esquema apunta a PostgreSQL
#
# Producción y desarrollo: cadena de Postgres (Neon, Vercel Postgres, Supabase).
#   vercel env pull .env.local   trae la del proyecto ya desplegado.
#
# Para trabajar en local sin servidor: `npm run db:use-sqlite` y
#   DATABASE_URL="file:./dev.db"
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:clave@host/basedatos?sslmode=require"

# ---------------------------------------------------------------------------
# NextAuth — generar con: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="genera-uno-con-openssl-rand-base64-32"

# ---------------------------------------------------------------------------
# Tienda
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Formato internacional sin "+" ni espacios. Cambiar por el número real.
NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"

# Credenciales del primer administrador (solo se usan al ejecutar el seed).
ADMIN_EMAIL="admin@novatech.co"
ADMIN_PASSWORD="NovaTech2026!"
ADMIN_NAME="Equipo Nova"
